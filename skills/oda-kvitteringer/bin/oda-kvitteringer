#!/usr/bin/env python3
"""oda-kvitteringer — hent dine egne ordrer og kvitteringer fra oda.com.

Strukturert utdata: JSON på stdout, diagnostikk på stderr. Ingen avhengigheter
utover Python 3.9+ stdlib.

  oda-kvitteringer oppsett            logg inn én gang, lagre sesjonen
  oda-kvitteringer status             er sesjonen i live?
  oda-kvitteringer ordrer             list ordrer (nyeste først)
  oda-kvitteringer ordre <nr>         én ordre, normalisert
  oda-kvitteringer raa <nr>           uendret API-svar for én ordre
  oda-kvitteringer hent               hent alle ordrer til disk, inkrementelt
  oda-kvitteringer logout             glem sesjonen

LEGITIMASJON LAGRES ALDRI I REPOET. Passordet lagres ikke i det hele tatt — det
brukes til ett innloggingskall, og bare sesjonsinformasjonskapslene skrives til
~/.config/oda-kvitteringer/session.json med mode 0600. Se AUTH.md.

GOD OPPFØRSEL: https://oda.com/robots.txt ber om en identifiserende User-Agent
med kontaktinfo, eksponentiell backoff og respekt for Retry-After. Denne
klienten gjør alle tre.
"""
from __future__ import annotations

import argparse
import getpass
import json
import os
import random
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from http.cookies import SimpleCookie
from pathlib import Path

BASE = "https://oda.com"
LOGIN_PAGE = f"{BASE}/no/user/login/"
LOGIN_API = f"{BASE}/api/v1/user/login/"
ORDERS_API = f"{BASE}/api/v1/orders/"

VERSION = "1.0.0"
DEFAULT_CONTACT = "ukjent-kontakt"

MAX_RETRIES = 5
MAX_PAGES = 500  # hard stopp mot en paginering som aldri tar slutt


# --------------------------------------------------------------------------
# Stier. Alt personlig bor utenfor repoet.
# --------------------------------------------------------------------------

def config_dir() -> Path:
    env = os.environ.get("ODA_KVITTERINGER_CONFIG_DIR")
    if env:
        return Path(env).expanduser()
    base = os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config")
    return Path(base).expanduser() / "oda-kvitteringer"


def data_dir() -> Path:
    env = os.environ.get("ODA_KVITTERINGER_DATA_DIR")
    if env:
        return Path(env).expanduser()
    base = os.environ.get("XDG_DATA_HOME") or (Path.home() / ".local" / "share")
    return Path(base).expanduser() / "oda-kvitteringer"


def write_private(path: Path, text: str) -> None:
    """Skriv med 0600 fra første byte. touch + chmod har et vindu der filen
    er verdenslesbar."""
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(text)
    os.chmod(path, 0o600)


# --------------------------------------------------------------------------
# Feil som sier hva brukeren skal gjøre
# --------------------------------------------------------------------------

class OdaError(Exception):
    """Feil vi kan forklare. Meldingen går til brukeren som den er."""


class SessionExpired(OdaError):
    def __init__(self, detail: str = ""):
        super().__init__(
            "Sesjonen mot Oda er utløpt eller mangler."
            + (f" ({detail})" if detail else "")
            + "\nKjør:  oda-kvitteringer oppsett"
        )


class ShapeChanged(OdaError):
    """API-et svarte, men ikke med det vi forventet. Dette er aldri det samme
    som 'ingen data' — og må aldri rapporteres som tomt resultat."""


# --------------------------------------------------------------------------
# HTTP
# --------------------------------------------------------------------------

class Client:
    def __init__(self, contact: str = DEFAULT_CONTACT, verbose: bool = False):
        self.cookies: dict[str, str] = {}
        self.contact = contact
        self.verbose = verbose

    # robots.txt ber eksplisitt om "bot" i navnet pluss en kontaktadresse.
    def user_agent(self) -> str:
        return f"oda-kvitteringer-bot/{VERSION} (+{self.contact})"

    def log(self, msg: str) -> None:
        if self.verbose:
            print(f"[oda] {msg}", file=sys.stderr)

    # -- informasjonskapsler ------------------------------------------------

    def load_session(self) -> None:
        path = config_dir() / "session.json"
        if not path.exists():
            raise SessionExpired("ingen lagret sesjon")
        try:
            raw = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as e:
            raise SessionExpired(f"kunne ikke lese {path}: {e}") from e
        cookies = raw.get("cookies")
        if not isinstance(cookies, dict) or not cookies:
            raise SessionExpired(f"{path} inneholder ingen informasjonskapsler")
        self.cookies = {str(k): str(v) for k, v in cookies.items()}

    def save_session(self) -> Path:
        path = config_dir() / "session.json"
        write_private(path, json.dumps({"cookies": self.cookies}, indent=2) + "\n")
        return path

    def _absorb_cookies(self, headers) -> None:
        for header in headers.get_all("Set-Cookie") or []:
            jar = SimpleCookie()
            try:
                jar.load(header)
            except Exception:  # noqa: BLE001 - en ødelagt kapsel skal ikke velte alt
                continue
            for name, morsel in jar.items():
                self.cookies[name] = morsel.value

    def cookie_header(self) -> str:
        return "; ".join(f"{k}={v}" for k, v in self.cookies.items())

    # -- kall ---------------------------------------------------------------

    def request(
        self,
        url: str,
        *,
        method: str = "GET",
        payload: dict | None = None,
        referer: str | None = None,
        want_json: bool = True,
    ):
        body = json.dumps(payload).encode("utf-8") if payload is not None else None

        for attempt in range(MAX_RETRIES):
            headers = {
                "User-Agent": self.user_agent(),
                "Accept": "application/json",
            }
            if self.cookies:
                headers["Cookie"] = self.cookie_header()
            if body is not None:
                headers["Content-Type"] = "application/json"
            if referer:
                headers["Referer"] = referer
                headers["Origin"] = BASE
            csrf = self.cookies.get("csrftoken")
            if csrf and method != "GET":
                headers["X-CSRFToken"] = csrf

            req = urllib.request.Request(url, data=body, headers=headers, method=method)
            try:
                with urllib.request.urlopen(req, timeout=60) as resp:
                    self._absorb_cookies(resp.headers)
                    raw = resp.read()
                    if not want_json:
                        return resp.status, raw
                    if not raw:
                        return resp.status, None
                    try:
                        return resp.status, json.loads(raw.decode("utf-8"))
                    except (UnicodeDecodeError, json.JSONDecodeError) as e:
                        # Et HTML-svar her betyr som regel at vi ble sendt til
                        # innloggingssiden. Det er en utløpt sesjon, ikke tomme data.
                        head = raw[:200].decode("utf-8", errors="replace")
                        if "<html" in head.lower() or "<!doctype" in head.lower():
                            raise SessionExpired("fikk en HTML-side der JSON var ventet") from e
                        raise ShapeChanged(
                            f"Oda svarte {resp.status} på {url}, men innholdet var ikke JSON.\n"
                            f"Første 200 tegn: {head!r}"
                        ) from e

            except urllib.error.HTTPError as e:
                self._absorb_cookies(e.headers)
                if e.code in (401, 403):
                    raise SessionExpired(f"HTTP {e.code}") from e
                if e.code in (425, 429) or e.code >= 500:
                    if attempt == MAX_RETRIES - 1:
                        raise OdaError(
                            f"Oda svarte HTTP {e.code} på {url} etter "
                            f"{MAX_RETRIES} forsøk. Prøv igjen senere."
                        ) from e
                    self._sleep_before_retry(attempt, e.headers.get("Retry-After"))
                    continue
                detail = e.read()[:400].decode("utf-8", errors="replace")
                raise OdaError(f"Oda svarte HTTP {e.code} på {url}: {detail}") from e

            except urllib.error.URLError as e:
                if attempt == MAX_RETRIES - 1:
                    raise OdaError(f"Fikk ikke kontakt med Oda: {e.reason}") from e
                self._sleep_before_retry(attempt, None)

        raise OdaError("uventet: gikk tom for forsøk")

    def _sleep_before_retry(self, attempt: int, retry_after: str | None) -> None:
        if retry_after:
            try:
                delay = float(retry_after)
            except ValueError:
                delay = 2.0 ** attempt
        else:
            delay = 2.0 ** attempt
        delay = min(delay, 60.0) + random.uniform(0, 0.5)
        self.log(f"venter {delay:.1f}s før nytt forsøk")
        time.sleep(delay)

    # -- innlogging ---------------------------------------------------------

    def login(self, email: str, password: str) -> None:
        self.request(LOGIN_PAGE, want_json=False)
        if "csrftoken" not in self.cookies:
            raise OdaError(
                "Fikk ingen csrftoken-informasjonskapsel fra innloggingssiden.\n"
                "Innloggingsflyten hos Oda kan ha endret seg."
            )
        try:
            status, data = self.request(
                LOGIN_API,
                method="POST",
                payload={"username": email, "password": password},
                referer=LOGIN_PAGE,
            )
        except SessionExpired as e:
            raise OdaError(
                "Oda avviste innloggingen. Sjekk e-post og passord.\n"
                "Krever kontoen tofaktor, kan ikke dette verktøyet logge inn — "
                "logg inn i nettleser og se README for hvordan du limer inn sesjonen."
            ) from e

        if not self.cookies.get("sessionid"):
            raise OdaError(
                f"Innloggingen svarte HTTP {status}, men ga ingen sessionid.\n"
                "Det kan bety et ekstra steg (tofaktor eller verifisering) som "
                "dette verktøyet ikke håndterer.\n"
                f"Svar: {json.dumps(data)[:400] if data else '(tomt)'}"
            )


# --------------------------------------------------------------------------
# Normalisering
#
# Ordredetaljene er dokumentert av andre, ikke av Oda, og eksempelet der viser
# ikke om prisene er med. Derfor plukker vi fra en liste kandidatnøkler og
# rapporterer ALLTID hva vi ikke kjente igjen, i stedet for å late som om et
# manglende felt betyr null.
# --------------------------------------------------------------------------

DATE_KEYS = ("delivery_date", "date", "order_date", "created_at", "placed_at",
             "completed_at", "datetime", "delivery_datetime")
TOTAL_KEYS = ("total_gross_amount", "display_price", "total_amount", "total_price",
              "gross_amount", "total", "sum")
LINE_TOTAL_KEYS = ("display_price_total", "total_gross_amount", "line_total",
                   "total_price", "gross_amount", "amount", "price", "display_price")
UNIT_PRICE_KEYS = ("gross_unit_price", "unit_price", "price_per_unit", "gross_price")
NAME_KEYS = ("description", "full_name", "name", "product_name", "title")
QTY_KEYS = ("quantity", "count", "amount_ordered", "qty")

KNOWN_LINE_KEYS = set(
    LINE_TOTAL_KEYS + UNIT_PRICE_KEYS + NAME_KEYS + QTY_KEYS
) | {"product_id", "product", "id", "item_id", "from_recipe_id",
     "from_recipe_portions", "unit_price_quantity_abbreviation"}


def pick(d: dict, keys, default=None):
    for k in keys:
        if isinstance(d, dict) and d.get(k) not in (None, ""):
            return d[k]
    return default


def normalize_order(order_number: str, detail: dict, summary: dict | None = None) -> dict:
    if not isinstance(detail, dict):
        raise ShapeChanged(f"Ordre {order_number}: svaret var ikke et objekt.")

    items = detail.get("items")
    if not isinstance(items, dict) or "item_groups" not in items:
        raise ShapeChanged(
            f"Ordre {order_number}: mangler items.item_groups.\n"
            f"API-formatet har trolig endret seg. Toppnøkler i svaret: "
            f"{sorted(detail.keys())}\n"
            f"Se det uendrede svaret med:  oda-kvitteringer raa {order_number}"
        )

    groups = items.get("item_groups")
    if not isinstance(groups, list):
        raise ShapeChanged(
            f"Ordre {order_number}: items.item_groups var {type(groups).__name__}, "
            f"ikke en liste."
        )

    linjer: list[dict] = []
    ukjente: set[str] = set()
    priser_funnet = False

    for gi, group in enumerate(groups):
        if not isinstance(group, dict):
            continue
        for item in group.get("items") or []:
            if not isinstance(item, dict):
                continue
            product = item.get("product") if isinstance(item.get("product"), dict) else {}

            linjebelop = pick(item, LINE_TOTAL_KEYS)
            enhetspris = pick(item, UNIT_PRICE_KEYS) or pick(product, UNIT_PRICE_KEYS)
            if linjebelop is not None or enhetspris is not None:
                priser_funnet = True

            linjer.append({
                "produkt_id": item.get("product_id") or product.get("id"),
                "navn": pick(item, NAME_KEYS) or pick(product, NAME_KEYS),
                "antall": pick(item, QTY_KEYS),
                "enhetspris": enhetspris,
                "linjebelop": linjebelop,
                "fra_oppskrift_id": item.get("from_recipe_id"),
                "gruppe_indeks": gi,
            })
            ukjente |= {k for k in item.keys() if k not in KNOWN_LINE_KEYS}

    ut = {
        "ordrenummer": str(order_number),
        "dato": pick(summary or {}, DATE_KEYS),
        "maaned": (summary or {}).get("_maaned"),
        "totalbelop": pick(summary or {}, TOTAL_KEYS) or pick(detail, TOTAL_KEYS),
        "varelinjer": linjer,
        "_meta": {
            "priser_funnet": priser_funnet,
            "antall_varelinjer": len(linjer),
            "antall_grupper": len(groups),
            "ukjente_varelinjefelter": sorted(ukjente),
            "hentet": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        },
    }

    if not linjer:
        # Null grupper OG null linjer er mistenkelig nok til å si fra om.
        ut["_meta"]["advarsel"] = (
            "Ingen varelinjer funnet. Er dette en ekte tom ordre, eller har "
            f"formatet endret seg? Sjekk med: oda-kvitteringer raa {order_number}"
        )
    if not priser_funnet:
        ut["_meta"]["advarsel_priser"] = (
            "Fant ingen prisfelter på varelinjene. Enten inneholder ordredetaljene "
            "ikke priser, eller så heter feltene noe annet enn forventet. "
            f"Kjør 'oda-kvitteringer raa {order_number}' og se etter prisfelter — "
            "legg dem så til i LINE_TOTAL_KEYS/UNIT_PRICE_KEYS i dette skriptet."
        )
    return ut


# --------------------------------------------------------------------------
# Ordreliste
# --------------------------------------------------------------------------

def iter_order_summaries(client: Client):
    """Gå gjennom ordrelisten. Paginert på dato via get_more_url, ikke sidetall."""
    url = ORDERS_API
    seen: set[str] = set()
    pages = 0

    while url:
        if url in seen:
            raise ShapeChanged(
                f"Pagineringen gjentok URL-en {url}. Det er en feil i "
                "paginerings-kontrakten, ikke slutten på listen — stopper heller "
                "enn å levere delvise data som ser komplette ut."
            )
        seen.add(url)
        pages += 1
        if pages > MAX_PAGES:
            raise ShapeChanged(f"Ga opp etter {MAX_PAGES} sider med ordrer.")

        status, data = client.request(url)
        if not isinstance(data, dict) or "results" not in data:
            raise ShapeChanged(
                f"Ordrelisten svarte {status}, men uten 'results'.\n"
                f"Toppnøkler: {sorted(data.keys()) if isinstance(data, dict) else type(data).__name__}"
            )

        for group in data.get("results") or []:
            if not isinstance(group, dict):
                continue
            maaned = group.get("month")
            for order in group.get("orders") or []:
                if not isinstance(order, dict):
                    continue
                nr = order.get("order_number")
                if not nr:
                    continue
                enriched = dict(order)
                enriched["_maaned"] = maaned
                yield str(nr), enriched

        nxt = data.get("get_more_url") if data.get("has_more") else None
        url = resolve_oda_url(nxt) if nxt else None


def resolve_oda_url(candidate: str) -> str:
    """get_more_url kommer fra responskroppen og brukes med sesjonskapslene.
    Alt utenfor oda.com avvises."""
    absolute = urllib.parse.urljoin(BASE, str(candidate))
    parsed = urllib.parse.urlparse(absolute)
    if parsed.scheme != "https" or parsed.netloc != urllib.parse.urlparse(BASE).netloc:
        raise OdaError(f"Avviste paginerings-URL utenfor {BASE}: {candidate}")
    return absolute


def fetch_detail(client: Client, order_number: str):
    url = f"{ORDERS_API}{urllib.parse.quote(str(order_number))}/"
    _, data = client.request(url)
    return data


# --------------------------------------------------------------------------
# Kommandoer
# --------------------------------------------------------------------------

def load_config() -> dict:
    path = config_dir() / "config.json"
    if not path.exists():
        return {}
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}


def client_from_config(args) -> Client:
    cfg = load_config()
    contact = cfg.get("kontakt") or DEFAULT_CONTACT
    return Client(contact=contact, verbose=getattr(args, "verbose", False))


def cmd_oppsett(args) -> int:
    email = args.epost
    if not email:
        if not sys.stdin.isatty():
            raise OdaError("Uten terminal må e-post oppgis med --epost.")
        email = input("Oda-e-post: ").strip()
    if not email:
        raise OdaError("Ingen e-post oppgitt.")

    if args.pass_stdin:
        password = sys.stdin.readline().rstrip("\n")
    elif sys.stdin.isatty():
        password = getpass.getpass("Oda-passord (vises ikke): ")
    else:
        raise OdaError(
            "Uten terminal må passordet komme på stdin med --pass-stdin.\n"
            "Aldri som argument — argumenter havner i ps og skallhistorikk."
        )
    if not password:
        raise OdaError("Tomt passord.")

    contact = args.kontakt
    if not contact:
        if sys.stdin.isatty():
            contact = input(
                "Kontaktadresse for User-Agent (Oda ber om det i robots.txt): "
            ).strip()
        contact = contact or DEFAULT_CONTACT

    client = Client(contact=contact, verbose=args.verbose)
    client.login(email, password)
    del password

    # Verifiser med ett ekte lesekall før vi kaller det en suksess.
    next(iter_order_summaries(client), None)

    session_path = client.save_session()
    cfg_path = config_dir() / "config.json"
    write_private(cfg_path, json.dumps(
        {"epost": email, "kontakt": contact}, indent=2, ensure_ascii=False) + "\n")

    print(json.dumps({
        "status": "innlogget",
        "epost": email,
        "sesjon": str(session_path),
        "config": str(cfg_path),
        "data": str(data_dir()),
        "merk": "Passordet er ikke lagret. Sesjonen gjelder til Oda utløper den; "
                "kjør oppsett på nytt når den dør. Én gang per maskin.",
    }, ensure_ascii=False, indent=2))
    return 0


def cmd_status(args) -> int:
    client = client_from_config(args)
    client.load_session()
    first = next(iter_order_summaries(client), None)
    lagret = sorted((data_dir() / "ordrer").glob("*.json")) if (data_dir() / "ordrer").is_dir() else []
    print(json.dumps({
        "status": "innlogget",
        "nyeste_ordre": first[0] if first else None,
        "ordrer_lagret_lokalt": len(lagret),
        "datamappe": str(data_dir() / "ordrer"),
    }, ensure_ascii=False, indent=2))
    return 0


def cmd_ordrer(args) -> int:
    client = client_from_config(args)
    client.load_session()
    ut = []
    for nr, summary in iter_order_summaries(client):
        rad = {
            "ordrenummer": nr,
            "maaned": summary.get("_maaned"),
            "dato": pick(summary, DATE_KEYS),
            "totalbelop": pick(summary, TOTAL_KEYS),
        }
        if args.raa_felter:
            rad["_raa"] = {k: v for k, v in summary.items() if k != "_maaned"}
        ut.append(rad)
        if args.limit and len(ut) >= args.limit:
            break
    print(json.dumps(ut, ensure_ascii=False, indent=2))
    return 0


def cmd_ordre(args) -> int:
    client = client_from_config(args)
    client.load_session()
    summary = None
    if not args.uten_oppslag:
        for nr, s in iter_order_summaries(client):
            if nr == str(args.ordrenummer):
                summary = s
                break
    detail = fetch_detail(client, args.ordrenummer)
    print(json.dumps(normalize_order(args.ordrenummer, detail, summary),
                     ensure_ascii=False, indent=2))
    return 0


def cmd_raa(args) -> int:
    client = client_from_config(args)
    client.load_session()
    detail = fetch_detail(client, args.ordrenummer)
    print("ADVARSEL: dette er dine egne ordredata. Ikke lim det inn i repoet.",
          file=sys.stderr)
    print(json.dumps(detail, ensure_ascii=False, indent=2))
    return 0


def cmd_hent(args) -> int:
    client = client_from_config(args)
    client.load_session()
    out_dir = data_dir() / "ordrer"
    out_dir.mkdir(mode=0o700, parents=True, exist_ok=True)

    nye, hoppet, feilet = [], [], []
    priser_mangler = 0

    for nr, summary in iter_order_summaries(client):
        target = out_dir / f"{nr}.json"
        if target.exists() and not args.force:
            hoppet.append(nr)
            if args.limit and len(nye) >= args.limit:
                break
            continue
        try:
            detail = fetch_detail(client, nr)
            normalized = normalize_order(nr, detail, summary)
        except ShapeChanged as e:
            feilet.append({"ordrenummer": nr, "feil": str(e)})
            client.log(f"ordre {nr}: {e}")
            continue
        write_private(target, json.dumps(normalized, ensure_ascii=False, indent=2) + "\n")
        nye.append(nr)
        if not normalized["_meta"]["priser_funnet"]:
            priser_mangler += 1
        time.sleep(args.pause)  # høflighet, ikke ytelse
        if args.limit and len(nye) >= args.limit:
            break

    resultat = {
        "hentet": len(nye),
        "hoppet_over": len(hoppet),
        "feilet": len(feilet),
        "mappe": str(out_dir),
        "nye_ordrer": nye,
    }
    if feilet:
        resultat["feil"] = feilet
    if priser_mangler:
        resultat["advarsel_priser"] = (
            f"{priser_mangler} av {len(nye)} ordrer manglet prisfelter. "
            "Kjør 'oda-kvitteringer raa <nr>' på en av dem og se hva feltene heter."
        )
    print(json.dumps(resultat, ensure_ascii=False, indent=2))
    return 1 if feilet else 0


def cmd_logout(args) -> int:
    fjernet = []
    for name in ("session.json",):
        p = config_dir() / name
        if p.exists():
            p.unlink()
            fjernet.append(str(p))
    print(json.dumps({"status": "utlogget", "fjernet": fjernet,
                      "merk": "Hentede data i " + str(data_dir()) + " er ikke rørt."},
                     ensure_ascii=False, indent=2))
    return 0


# --------------------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(
        prog="oda-kvitteringer",
        description="Hent dine egne ordrer og kvitteringer fra oda.com. "
                    "JSON på stdout, diagnostikk på stderr.",
    )
    ap.add_argument("--verbose", "-v", action="store_true", help="Logg til stderr")
    sub = ap.add_subparsers(dest="kommando", required=True)

    p = sub.add_parser("oppsett", help="Logg inn én gang og lagre sesjonen")
    p.add_argument("--epost")
    p.add_argument("--pass-stdin", action="store_true",
                   help="Les passordet fra stdin i stedet for å spørre")
    p.add_argument("--kontakt", help="Kontaktadresse i User-Agent (robots.txt ber om det)")
    p.set_defaults(func=cmd_oppsett)

    p = sub.add_parser("status", help="Er sesjonen i live?")
    p.set_defaults(func=cmd_status)

    p = sub.add_parser("ordrer", help="List ordrer, nyeste først")
    p.add_argument("--limit", type=int, help="Stopp etter N ordrer")
    p.add_argument("--raa-felter", action="store_true",
                   help="Ta med hele det uendrede sammendraget per ordre")
    p.set_defaults(func=cmd_ordrer)

    p = sub.add_parser("ordre", help="Én ordre, normalisert")
    p.add_argument("ordrenummer")
    p.add_argument("--uten-oppslag", action="store_true",
                   help="Ikke bla gjennom ordrelisten for å finne dato og total")
    p.set_defaults(func=cmd_ordre)

    p = sub.add_parser("raa", help="Uendret API-svar for én ordre")
    p.add_argument("ordrenummer")
    p.set_defaults(func=cmd_raa)

    p = sub.add_parser("hent", help="Hent alle ordrer til disk, inkrementelt")
    p.add_argument("--force", action="store_true", help="Hent på nytt selv om filen finnes")
    p.add_argument("--limit", type=int, help="Stopp etter N nye ordrer")
    p.add_argument("--pause", type=float, default=1.0,
                   help="Sekunder mellom ordrekall (standard 1.0)")
    p.set_defaults(func=cmd_hent)

    p = sub.add_parser("logout", help="Glem sesjonen")
    p.set_defaults(func=cmd_logout)

    return ap


def main(argv=None) -> int:
    args = build_parser().parse_args(argv)
    try:
        return args.func(args)
    except OdaError as e:
        print(f"oda-kvitteringer: {e}", file=sys.stderr)
        return 2
    except KeyboardInterrupt:
        print("avbrutt", file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main())
