#!/usr/bin/env bash
# Kjør kjoleskap, oda-kvitteringer eller trumf-kvitteringer på maskinen som eier
# dataene, over ssh. Ingen data og ingen innlogging på denne maskinen.
#
#   kjoleskap-fjern status                   kjoleskap-kommandoer rett gjennom
#   kjoleskap-fjern varer --limit 20 --sok melk
#   kjoleskap-fjern oda lister               oda-kvitteringer på verten
#   kjoleskap-fjern trumf status             trumf-kvitteringer på verten
#
# Vert og sti: KJOLESKAP_VERT (standard matebook) og KJOLESKAP_STI (standard
# dev/personal/digital-kjoleskap, relativ til hjemmemappa på verten).
# Exit 255 = ssh feilet (verten er av, eller denne maskinen er ikke på nettet dit).
set -euo pipefail

VERT="${KJOLESKAP_VERT:-matebook}"
STI="${KJOLESKAP_STI:-dev/personal/digital-kjoleskap}"

case "${1:-}" in
  ""|-h|--help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  oda)   shift; BIN="skills/oda-kvitteringer/bin/oda-kvitteringer" ;;
  trumf) shift; BIN="skills/trumf-kvitteringer/bin/trumf-kvitteringer" ;;
  *)     BIN="skills/kjoleskap/bin/kjoleskap" ;;
esac

# Hvert argument siteres for skallet på verten, så «--sok "ost og brød"» kommer
# fram som ett argument.
printf -v ARGS ' %q' "$@"
# stdin følger med (f.eks. `trumf oppsett --json-stdin`), men bare når noe pipes inn.
if [ -t 0 ]; then
  exec ssh -o BatchMode=yes -o ConnectTimeout=10 "$VERT" "\$HOME/$STI/$BIN$ARGS" </dev/null
else
  exec ssh -o BatchMode=yes -o ConnectTimeout=10 "$VERT" "\$HOME/$STI/$BIN$ARGS"
fi
