#!/usr/bin/env python3
"""trumf-kvitteringer — bestill innsynsdumpen fra Trumf, hent den, og les den.

Hele veien, i fire steg, med lang ventetid i midten:

  trumf-kvitteringer oppsett            lim inn sesjonen fra nettleseren, én gang per maskin
  trumf-kvitteringer bestill            legg inn innsynsbestillingen (SISTE_3_AR, JSON)
  trumf-kvitteringer bestilling         er den klar? når ble den bestilt?
  trumf-kvitteringer hent               last ned når den er klar, og importer

Og parseren, som fortsatt virker helt uten innlogging:

  trumf-kvitteringer inspiser <fil>     hva ER dette? struktur uten verdier
  trumf-kvitteringer importer <fil>     parse og lagre normaliserte kvitteringer
  trumf-kvitteringer kvitteringer       list det som er importert
  trumf-kvitteringer varer              summer per vare
  trumf-kvitteringer status             hva ligger på disk
  trumf-kvitteringer logout             glem sesjonen

HVORFOR INNSYN OG IKKE SKRAPING: trumf.no viser 12 måneder, men Trumf lagrer
kvitteringer i tre år. Innsynsdumpen gir altså mer data enn skraping — og
bestillingen kan legges inn maskinelt, så det koster ikke ergonomi å velge den.

LEGITIMASJON LAGRES ALDRI I REPOET. Sesjonen bor i
~/.config/trumf-kvitteringer/session.json med mode 0600. Passordet ditt ser
verktøyet aldri: innloggingen hos Trumf har SMS-tofaktor og gjøres i nettleseren.
Se AUTH.md.

BESTILLINGEN ER ASYNKRON. Trumf har inntil 30 dager på seg. Verktøyet venter
aldri aktivt — det husker at du har bestilt, og `bestilling` spør når du lurer.
"""
from __future__ import annotations

import argparse
import base64
import getpass
import hashlib
import json
import os
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import zipfile
from datetime import datetime, timezone
from http.cookies import SimpleCookie
from pathlib import Path

VERSION = "2.0.0"

# Endepunktene. POST-en går til NorgesGruppens plattform-API, mens status og
# nedlasting går via trumf.no sin egen proxy — det er den samme veien
# profilsiden bruker når du klikker deg gjennom skjemaet.
NGDATA = "https://platform-rest-prod.ngdata.no"
TRUMF = "https://www.trumf.no"
CHAIN_ID = "133"  # NorgesGruppens kjede-id. Uten denne stopper WAF-en kallet.

# Innsyn (PDF) mot utlevering (JSON) er to separate bestillinger hos Trumf, og
# hele verktøyet holder seg til JSON-veien: PDF er ubrukelig å parse.
DATAPORTABILITET = "true"

PERIODER = ("SISTE_3_MANEDER", "SISTE_6_MANEDER", "SISTE_12_MANEDER",
            "SISTE_2_AR", "SISTE_3_AR")

MEDLEM_CLAIM = "http://id.trumf.no/claims/medlem"

MAX_REDIRECTS = 15
MAX_RETRIES = 4

# --------------------------------------------------------------------------
# Feltnavn vi kjenner igjen. Innsynsdumpen (2019) og plattform-API-et bruker
# ulike navn på det samme, og begge kan dukke opp.
#
# Utleveringsformatet slik det er dokumentert av NorgesGruppen selv
# (kjøpstransaksjoner_per_handel_per_vare.json):
#
#   {"dato": "12.03.2026", "kvitteringsnummer": "61719", "kjede": null,
#    "butikknavn": "KIWI 326 ...", "totaltBelop": "1218.65", "korttype": "ZTLD",
#    "kanal": null, "varelinjer": [{"varenavn": ..., "vareAntallVekt": "1.000",
#                                   "vareBelop": "24.40"}]}
#
# Merk `totaltBelop` med t — ikke `totalBelop`. Feltet står først i TOTAL_KEYS.
# --------------------------------------------------------------------------

LINES_KEYS = ("varelinjer", "varer", "linjer", "items", "lines")
DATE_KEYS = ("dato", "kjopsdato", "kjøpsdato", "transaksjonsdato", "date", "datetime")
RECEIPT_ID_KEYS = ("kvitteringsnummer", "batchid", "batchId", "transaksjonsid",
                   "kvitteringsid", "id")
CHAIN_KEYS = ("kjede", "kjedenavn", "kjedeId", "kjedeid", "chain")
STORE_KEYS = ("butikknavn", "butikk", "butikkNavn", "beskrivelse", "storeName", "sted")
TOTAL_KEYS = ("totaltBelop", "belop", "beløp", "totalbelop", "totalBelop",
              "sum", "totalsum")
BONUS_KEYS = ("trumf", "trumftotal", "bonus", "trumfbonus")

LINE_NAME_KEYS = ("varenavn", "vareTekst", "varetekst", "navn", "produktnavn", "tekst")
LINE_QTY_KEYS = ("vareAntallVekt", "antall", "vareAntall", "kvantum", "mengde")
LINE_AMOUNT_KEYS = ("vareBelop", "vareBeløp", "belop", "beløp", "sum", "pris", "linjebelop")
LINE_EAN_KEYS = ("ean", "EAN", "gtin", "strekkode", "varenummer")

KNOWN_LINE_KEYS = set(LINE_NAME_KEYS + LINE_QTY_KEYS + LINE_AMOUNT_KEYS + LINE_EAN_KEYS)

DATE_FORMATS = ("%d.%m.%Y %H:%M:%S", "%d.%m.%Y %H:%M", "%d.%m.%Y",
                "%Y-%m-%dT%H:%M:%S", "%Y-%m-%d %H:%M:%S", "%Y-%m-%d")


class TrumfError(Exception):
    """Feil vi kan forklare. Meldingen går til brukeren som den er."""


class SessionExpired(TrumfError):
    """Sesjonen er borte og kan ikke fornyes. Aldri det samme som tomt svar."""

    def __init__(self, detail: str = ""):
        super().__init__(
            "Sesjonen mot Trumf er utløpt eller mangler."
            + (f" ({detail})" if detail else "")
            + "\nKjør:  trumf-kvitteringer oppsett"
        )


class ShapeChanged(TrumfError):
    """Tjenesten svarte, men ikke med det vi ventet. Ikke 'ingen data'."""


# --------------------------------------------------------------------------
# Stier. Alt personlig bor utenfor repoet.
# --------------------------------------------------------------------------

def config_dir() -> Path:
    env = os.environ.get("TRUMF_KVITTERINGER_CONFIG_DIR")
    if env:
        return Path(env).expanduser()
    base = os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config")
    return Path(base).expanduser() / "trumf-kvitteringer"


def data_dir() -> Path:
    env = os.environ.get("TRUMF_KVITTERINGER_DATA_DIR")
    if env:
        return Path(env).expanduser()
    base = os.environ.get("XDG_DATA_HOME") or (Path.home() / ".local" / "share")
    return Path(base).expanduser() / "trumf-kvitteringer"


def receipts_dir() -> Path:
    return data_dir() / "kvitteringer"


def dumps_dir() -> Path:
    return data_dir() / "dumper"


def write_private(path: Path, text: str) -> None:
    """Skriv med 0600 fra første byte. touch + chmod har et vindu der filen
    er verdenslesbar."""
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(text)
    os.chmod(path, 0o600)


def write_private_bytes(path: Path, blob: bytes) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "wb") as fh:
        fh.write(blob)
    os.chmod(path, 0o600)


def read_json(path: Path):
    if not path.exists():
        return None
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None


def now_iso() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat()


# --------------------------------------------------------------------------
# JWT. Vi verifiserer ingen signatur — vi leser bare medlems-id og utløpstid ut
# av et token vi selv nettopp fikk utlevert. Trumf verifiserer det for oss.
# --------------------------------------------------------------------------

def jwt_payload(token: str):
    parts = (token or "").split(".")
    if len(parts) != 3:
        return None
    body = parts[1]
    body += "=" * (-len(body) % 4)
    try:
        return json.loads(base64.urlsafe_b64decode(body.encode()))
    except Exception:  # noqa: BLE001 — et ulesbart token er bare et ugyldig token
        return None


def token_utloper(token: str):
    payload = jwt_payload(token) or {}
    exp = payload.get("exp")
    return int(exp) if isinstance(exp, (int, float)) else None


def medlem_fra_token(token: str):
    payload = jwt_payload(token) or {}
    verdi = payload.get(MEDLEM_CLAIM)
    return str(verdi) if verdi not in (None, "") else None


def maskert(verdi) -> str:
    """Medlemsnummeret er en personopplysning. Vi bekrefter at vi har det uten
    å skrive det ut i sin helhet."""
    s = str(verdi or "")
    return ("…" + s[-4:]) if len(s) > 4 else "…"


# --------------------------------------------------------------------------
# Informasjonskapsler fra nettleseren
# --------------------------------------------------------------------------

def parse_cookie_input(text: str) -> dict[str, str]:
    """Ta imot det brukeren faktisk har i utklippstavlen.

    Tre former, fordi alle tre er ett tastetrykk unna i utviklerverktøyene:
    en rå `Cookie:`-header, utdata fra `document.cookie`, eller hele
    «Copy as cURL»-kommandoen.
    """
    text = (text or "").strip()
    if not text:
        return {}

    if text.lstrip().startswith("curl"):
        biter: list[str] = []
        for m in re.finditer(r"""-H\s+(['"])(.*?)\1""", text, re.S):
            header = m.group(2)
            navn, _, verdi = header.partition(":")
            if navn.strip().lower() == "cookie":
                biter.append(verdi)
        for m in re.finditer(r"""(?:^|\s)-b\s+(['"])(.*?)\1""", text, re.S):
            biter.append(m.group(2))
        text = "; ".join(biter)

    if text[:7].lower() == "cookie:":
        text = text[7:]

    ut: dict[str, str] = {}
    for bit in text.split(";"):
        navn, sep, verdi = bit.strip().partition("=")
        if not sep:
            continue
        navn = navn.strip()
        if navn:
            ut[navn] = verdi.strip()
    return ut


# --------------------------------------------------------------------------
# HTTP
#
# Vi følger omdirigeringene selv i stedet for å la urllib gjøre det. Grunnen er
# konkret: innloggingskjeden hos Trumf setter nye informasjonskapsler på hvert
# hopp, og urllib gir oss bare headerne fra det siste svaret. Følger vi selv,
# fanger vi hver Set-Cookie underveis.
# --------------------------------------------------------------------------

DEFAULT_UA = f"trumf-kvitteringer/{VERSION} (personlig innsynsverktøy)"


def user_agent() -> str:
    return os.environ.get("TRUMF_KVITTERINGER_USER_AGENT") or DEFAULT_UA


class _IngenOmdirigering(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


class Client:
    def __init__(self, verbose: bool = False):
        self.cookies: dict[str, str] = {}
        self.token: str | None = None
        self.medlem_id: str | None = None
        self.verbose = verbose
        self._opener = urllib.request.build_opener(_IngenOmdirigering)

    def log(self, melding: str) -> None:
        if self.verbose:
            print(f"[trumf] {melding}", file=sys.stderr)

    # -- sesjon -------------------------------------------------------------

    @staticmethod
    def session_path() -> Path:
        return config_dir() / "session.json"

    def load_session(self) -> None:
        raw = read_json(self.session_path())
        if not raw:
            raise SessionExpired("ingen lagret sesjon")
        cookies = raw.get("cookies")
        if not isinstance(cookies, dict) or not cookies:
            raise SessionExpired(f"{self.session_path()} har ingen informasjonskapsler")
        self.cookies = {str(k): str(v) for k, v in cookies.items()}
        self.token = raw.get("token") or None
        self.medlem_id = raw.get("medlem_id") or None

    def save_session(self) -> Path:
        path = self.session_path()
        write_private(path, json.dumps({
            "cookies": self.cookies,
            "token": self.token,
            "medlem_id": self.medlem_id,
            "oppdatert": now_iso(),
        }, ensure_ascii=False, indent=2) + "\n")
        return path

    # -- informasjonskapsler ------------------------------------------------

    def cookie_header(self) -> str:
        return "; ".join(f"{k}={v}" for k, v in self.cookies.items())

    def _absorb(self, headers) -> None:
        for header in headers.get_all("Set-Cookie") or []:
            jar = SimpleCookie()
            try:
                jar.load(header)
            except Exception:  # noqa: BLE001 — én ødelagt kapsel skal ikke velte alt
                continue
            for navn, morsel in jar.items():
                if morsel.value:
                    self.cookies[navn] = morsel.value

    # -- kall ---------------------------------------------------------------

    def request(self, url, *, method="GET", body=None, auth=False, follow=False,
                timeout=60, ekstra=None):
        """Returnerer (status, headers, kropp, siste_url)."""
        hdrs = {"User-Agent": user_agent(), "Accept": "*/*"}
        if auth:
            if not self.token:
                raise SessionExpired("ingen tilgangstoken i sesjonen")
            hdrs["Authorization"] = f"Bearer {self.token}"
            hdrs["FWC-Chain-Id"] = CHAIN_ID
        if body is not None:
            hdrs["Content-Type"] = "application/json"
        hdrs.update(ekstra or {})

        current, hopp, forsok = url, 0, 0
        while True:
            if self.cookies:
                hdrs["Cookie"] = self.cookie_header()
            req = urllib.request.Request(current, data=body, headers=hdrs, method=method)
            try:
                with self._opener.open(req, timeout=timeout) as resp:
                    self._absorb(resp.headers)
                    return resp.status, resp.headers, resp.read(), current

            except urllib.error.HTTPError as e:
                self._absorb(e.headers)
                if e.code in (301, 302, 303, 307, 308) and follow:
                    plassering = e.headers.get("Location")
                    e.close()
                    if not plassering:
                        raise ShapeChanged(
                            f"Trumf svarte {e.code} på {current} uten Location-header."
                        ) from e
                    hopp += 1
                    if hopp > MAX_REDIRECTS:
                        raise TrumfError(
                            f"Ga opp etter {MAX_REDIRECTS} omdirigeringer fra {url}."
                        ) from e
                    current = urllib.parse.urljoin(current, plassering)
                    if e.code in (301, 302, 303):
                        method, body = "GET", None
                        hdrs.pop("Content-Type", None)
                    continue

                if e.code in (401, 403):
                    raise SessionExpired(f"HTTP {e.code} på {current}") from e

                if e.code == 429 or e.code >= 500:
                    if forsok >= MAX_RETRIES - 1:
                        raise TrumfError(
                            f"Trumf svarte HTTP {e.code} på {current} etter "
                            f"{MAX_RETRIES} forsøk. Prøv igjen senere."
                        ) from e
                    self._vent(forsok, e.headers.get("Retry-After"))
                    forsok += 1
                    continue

                detalj = e.read()[:400].decode("utf-8", errors="replace")
                raise TrumfError(f"Trumf svarte HTTP {e.code} på {current}: {detalj}") from e

            except urllib.error.URLError as e:
                if forsok >= MAX_RETRIES - 1:
                    raise TrumfError(f"Fikk ikke kontakt med Trumf: {e.reason}") from e
                self._vent(forsok, None)
                forsok += 1

    def _vent(self, forsok: int, retry_after) -> None:
        try:
            pause = float(retry_after) if retry_after else 2.0 ** forsok
        except (TypeError, ValueError):
            pause = 2.0 ** forsok
        pause = min(pause, 60.0)
        self.log(f"venter {pause:.1f}s før nytt forsøk")
        time.sleep(pause)

    def json_kall(self, url, **kw):
        status, headers, raw, _ = self.request(url, **kw)
        if not raw:
            return status, None
        try:
            return status, json.loads(raw.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError) as e:
            start = raw[:200].decode("utf-8", errors="replace")
            if "<html" in start.lower() or "<!doctype" in start.lower():
                raise SessionExpired("fikk en HTML-side der JSON var ventet") from e
            raise ShapeChanged(
                f"Trumf svarte {status} på {url}, men innholdet var ikke JSON.\n"
                f"Første 200 tegn: {start!r}"
            ) from e

    # -- token --------------------------------------------------------------

    def _token_fra_gettoken(self):
        try:
            _, _, raw, _ = self.request(f"{TRUMF}/api/auth/getToken")
        except TrumfError as e:
            self.log(f"getToken feilet: {e}")
            return None
        token = raw.decode("utf-8", errors="replace").strip().strip('"')
        return token if token.startswith("eyJ") else None

    def _sesjonsobjekt(self):
        """/api/auth/session gir både accessToken og medlemsnummer."""
        try:
            _, data = self.json_kall(f"{TRUMF}/api/auth/session")
        except TrumfError as e:
            self.log(f"auth/session feilet: {e}")
            return None
        return data if isinstance(data, dict) else None

    def _token_fra_sesjon(self):
        data = self._sesjonsobjekt() or {}
        for nokkel in ("accessToken", "access_token", "token"):
            verdi = data.get(nokkel)
            if isinstance(verdi, str) and verdi.startswith("eyJ"):
                return verdi
        return None

    def _fornye_via_idsrv(self):
        """Reservevei: idsrv-kapselen hos id.trumf.no kan gi oss en ny
        www-sesjon gjennom OAuth-omdirigeringene, uten at brukeren merker noe."""
        if "idsrv" not in self.cookies:
            self.log("ingen idsrv-kapsel, hopper over reserveveien")
            return None
        self.log("prøver idsrv-reserveveien")
        try:
            _, _, _, siste = self.request(
                f"{TRUMF}/api/login?providerHandle=trumf-personal", follow=True)
        except TrumfError as e:
            self.log(f"idsrv-reserveveien feilet: {e}")
            return None
        if "id.trumf.no/ui/login" in siste:
            self.log("havnet på innloggingssiden — idsrv er utløpt")
            return None
        return self._token_fra_gettoken() or self._token_fra_sesjon()

    def _token_er_ferskt(self) -> bool:
        if not self.token:
            return False
        utloper = token_utloper(self.token)
        if utloper is None:
            return False  # ukjent utløp: hent heller et nytt
        return utloper - 120 > time.time()

    def ensure_token(self) -> str:
        """Et gyldig token, eller en beskjed om at brukeren må logge inn igjen.

        Returnerer aldri tomt. Et utløpt token som ikke lar seg fornye er en
        feil brukeren kan gjøre noe med, ikke en tom liste med kvitteringer.
        """
        if self._token_er_ferskt():
            return self.token

        for hent in (self._token_fra_gettoken, self._token_fra_sesjon,
                     self._fornye_via_idsrv):
            token = hent()
            if token:
                self.token = token
                self.medlem_id = medlem_fra_token(token) or self.medlem_id
                self.save_session()
                return token

        raise SessionExpired(
            "informasjonskapslene fra nettleseren er ikke gyldige lenger")

    def finn_medlem_id(self):
        if self.medlem_id:
            return self.medlem_id
        if self.token:
            self.medlem_id = medlem_fra_token(self.token)
        if not self.medlem_id:
            data = self._sesjonsobjekt() or {}
            for nokkel in ("memberId", "medlemId", "medlemsnummer"):
                if data.get(nokkel):
                    self.medlem_id = str(data[nokkel])
                    break
        return self.medlem_id

    # -- innsyn -------------------------------------------------------------

    def bestill(self, periode: str, *, per_handel: bool = True,
                bonus: bool = True) -> dict:
        medlem = self.finn_medlem_id()
        if not medlem:
            raise ShapeChanged(
                "Fant ikke medlemsnummeret ditt.\n"
                f"Det skal ligge som «{MEDLEM_CLAIM}» i tokenet, eller som "
                "memberId fra /api/auth/session. Ingen av delene var der, så "
                "innloggingsformatet hos Trumf har trolig endret seg.\n"
                "Kjør:  trumf-kvitteringer oppsett"
            )
        bestilling = {
            "medlemId": medlem,
            "onskerProfil": False,
            "onskerDigitalHistorikk": False,
            "onskerDialoghistorikk": False,
            "onskerOrdrehistorikk": False,
            "onskerSalgshistorikk": bonus,
            "onskerSalgshistorikkPerHandel": per_handel,
            "periode": periode,
            "format": "JSON",
        }
        status, _, raw, _ = self.request(
            f"{NGDATA}/innsyn", method="POST",
            body=json.dumps(bestilling).encode("utf-8"), auth=True)
        if status != 201:
            detalj = raw[:300].decode("utf-8", errors="replace") if raw else "(tomt svar)"
            raise ShapeChanged(
                f"Bestillingen svarte HTTP {status}, ikke 201 Created.\n"
                f"Svar: {detalj}\n"
                "Bestillingen er trolig IKKE lagt inn. Sjekk med: "
                "trumf-kvitteringer bestilling"
            )
        return bestilling

    def hent_bestillingsstatus(self) -> dict:
        _, data = self.json_kall(
            f"{TRUMF}/api/common/orderinsight/getstatus"
            f"?isDataportability={DATAPORTABILITET}", auth=True)
        if not isinstance(data, dict) or "OrderReady" not in data:
            raise ShapeChanged(
                "Statuskallet svarte, men uten OrderReady.\n"
                f"Fikk: {sorted(data.keys()) if isinstance(data, dict) else type(data).__name__}"
            )
        return {
            "klar": bool(data.get("OrderReady")),
            "aktiv": bool(data.get("OrderActive")),
            "bestilt": data.get("OrderTime"),
            "utloper": data.get("OrderExpiration"),
            "periode": data.get("Period"),
        }

    def last_ned(self) -> bytes:
        _, headers, raw, url = self.request(
            f"{TRUMF}/api/common/orderinsight/getfiles"
            f"?isDataportability={DATAPORTABILITET}", auth=True, timeout=300)
        if len(raw) < 100:
            raise ShapeChanged(
                f"Nedlastingen ga bare {len(raw)} byte. Det er ikke en dump.\n"
                "Sjekk med:  trumf-kvitteringer bestilling"
            )
        ctype = (headers.get("Content-Type") or "").lower()
        if "html" in ctype or raw[:15].lower().startswith(b"<!doctype"):
            raise SessionExpired("nedlastingen ga en HTML-side, ikke en fil")
        return raw


# --------------------------------------------------------------------------
# Bestillingen huskes lokalt, så vi ikke bestiller to ganger ved et uhell
# --------------------------------------------------------------------------

def bestilling_path() -> Path:
    return config_dir() / "bestilling.json"


def les_bestilling():
    return read_json(bestilling_path())


def skriv_bestilling(record: dict) -> Path:
    path = bestilling_path()
    write_private(path, json.dumps(record, ensure_ascii=False, indent=2) + "\n")
    return path


def dager_siden(iso: str | None):
    if not iso:
        return None
    tekst = str(iso).replace("Z", "+00:00")
    for kandidat in (tekst, tekst + "+00:00"):
        try:
            dt = datetime.fromisoformat(kandidat)
        except ValueError:
            continue
        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=timezone.utc)
        return round((datetime.now(timezone.utc) - dt).total_seconds() / 86400, 1)
    return None


# --------------------------------------------------------------------------
# Innlesing. Dumpen kan komme som JSON, JSON-linjer eller zip.
# --------------------------------------------------------------------------

def load_any(path: Path):
    if not path.exists():
        raise TrumfError(f"Fant ikke filen: {path}")

    if zipfile.is_zipfile(path):
        with zipfile.ZipFile(path) as zf:
            members = [n for n in zf.namelist() if n.lower().endswith(".json")]
            if not members:
                raise TrumfError(
                    f"{path} er en zip, men uten JSON-filer i.\n"
                    f"Innhold: {zf.namelist()[:20]}"
                )
            docs = []
            for name in members:
                with zf.open(name) as fh:
                    docs.append(parse_bytes(fh.read(), f"{path}!{name}"))
            return docs[0] if len(docs) == 1 else docs

    return parse_bytes(path.read_bytes(), str(path))


def parse_bytes(raw: bytes, label: str):
    text = raw.decode("utf-8-sig", errors="replace").strip()
    if not text:
        raise TrumfError(f"{label} er tom.")
    try:
        return json.loads(text)
    except json.JSONDecodeError:
        pass
    # JSON-linjer?
    rows, bad = [], 0
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            rows.append(json.loads(line))
        except json.JSONDecodeError:
            bad += 1
    if rows and bad == 0:
        return rows
    raise TrumfError(
        f"{label} er verken gyldig JSON eller JSON-linjer.\n"
        f"Første 200 tegn: {text[:200]!r}\n"
        "Er dette en CSV eller PDF? Da trenger parseren en oppdatering — "
        "kjør 'inspiser' på filen og del strukturen."
    )


# --------------------------------------------------------------------------
# Finn kvitteringene i dokumentet, uansett hvor de er pakket inn
# --------------------------------------------------------------------------

def looks_like_receipt(d) -> bool:
    return isinstance(d, dict) and any(
        isinstance(d.get(k), list) for k in LINES_KEYS
    )


def find_receipts(doc, _depth: int = 0):
    """Innsynsdumpen kan være en bar liste, eller pakket inn i et objekt med
    metadata rundt. Let etter den første listen som ser ut som kvitteringer."""
    if _depth > 6:
        return []
    if isinstance(doc, list):
        hits = [d for d in doc if looks_like_receipt(d)]
        if hits:
            return hits
        for item in doc:
            found = find_receipts(item, _depth + 1)
            if found:
                return found
        return []
    if isinstance(doc, dict):
        if looks_like_receipt(doc):
            return [doc]
        for value in doc.values():
            found = find_receipts(value, _depth + 1)
            if found:
                return found
    return []


# --------------------------------------------------------------------------
# Verdikonvertering
# --------------------------------------------------------------------------

def pick(d: dict, keys, default=None):
    for k in keys:
        if isinstance(d, dict) and d.get(k) not in (None, ""):
            return d[k]
    return default


def to_number(value):
    """Innsynsdumpen bruker norsk desimalkomma ('41,60'); plattform-API-et
    bruker punktum ('29.90'). Siste separator vinner som desimalskille."""
    if value is None or value == "":
        return None
    if isinstance(value, (int, float)):
        return float(value)
    s = str(value).replace(" ", "").replace(" ", "").strip()
    s = re.sub(r"[^0-9,.\-]", "", s)
    if not s:
        return None
    last_comma, last_dot = s.rfind(","), s.rfind(".")
    if last_comma > last_dot:
        s = s.replace(".", "").replace(",", ".")
    elif last_dot > last_comma:
        s = s.replace(",", "")
    else:
        s = s.replace(",", ".")
    try:
        return float(s)
    except ValueError:
        return None


def to_date(value):
    """Returnerer (iso_dato, original) — original beholdes når vi ikke forstår."""
    if value is None or value == "":
        return None, None
    s = str(value).strip()
    for fmt in DATE_FORMATS:
        try:
            return datetime.strptime(s, fmt).date().isoformat(), s
        except ValueError:
            continue
    return None, s


# --------------------------------------------------------------------------
# Normalisering
# --------------------------------------------------------------------------

def normalize_receipt(raw: dict) -> dict:
    lines_raw = None
    for k in LINES_KEYS:
        if isinstance(raw.get(k), list):
            lines_raw = raw[k]
            break
    if lines_raw is None:
        raise TrumfError(f"Kvittering uten varelinjer. Nøkler: {sorted(raw.keys())}")

    iso, original = to_date(pick(raw, DATE_KEYS))
    ukjente: set[str] = set()
    linjer = []

    for line in lines_raw:
        if not isinstance(line, dict):
            continue
        linjer.append({
            "varenavn": pick(line, LINE_NAME_KEYS),
            "antall": to_number(pick(line, LINE_QTY_KEYS)),
            "belop": to_number(pick(line, LINE_AMOUNT_KEYS)),
            "ean": pick(line, LINE_EAN_KEYS),
        })
        ukjente |= {k for k in line.keys() if k not in KNOWN_LINE_KEYS}

    kvitteringsnummer = pick(raw, RECEIPT_ID_KEYS)
    if kvitteringsnummer is None:
        # Uten id lager vi en stabil en av innholdet, så gjentatt import ikke
        # dupliserer den samme kvitteringen.
        seed = json.dumps(raw, sort_keys=True, ensure_ascii=False)
        kvitteringsnummer = "auto-" + hashlib.sha256(seed.encode()).hexdigest()[:16]

    total = to_number(pick(raw, TOTAL_KEYS))
    sum_linjer = sum(l["belop"] for l in linjer if l["belop"] is not None) or None

    ut = {
        "kvitteringsnummer": str(kvitteringsnummer),
        "dato": iso,
        "kjede": pick(raw, CHAIN_KEYS),
        "butikknavn": pick(raw, STORE_KEYS),
        "totalbelop": total,
        "bonus": to_number(pick(raw, BONUS_KEYS)),
        "varelinjer": linjer,
        "_meta": {
            "antall_varelinjer": len(linjer),
            "sum_varelinjer": round(sum_linjer, 2) if sum_linjer is not None else None,
            "ukjente_varelinjefelter": sorted(ukjente),
            "ukjente_kvitteringsfelter": sorted(
                k for k in raw.keys()
                if k not in set(LINES_KEYS + DATE_KEYS + RECEIPT_ID_KEYS + CHAIN_KEYS
                                + STORE_KEYS + TOTAL_KEYS + BONUS_KEYS)
            ),
        },
    }

    if iso is None and original is not None:
        ut["_meta"]["dato_uforstaatt"] = original
    # Avstemming: summen av linjene mot totalen fanger opp at parsingen mistet noe.
    if total is not None and sum_linjer is not None and abs(total - sum_linjer) > 0.05:
        ut["_meta"]["advarsel_sum"] = (
            f"Varelinjene summerer til {sum_linjer:.2f}, men kvitteringen sier "
            f"{total:.2f}. Rabatt, pant eller et felt vi ikke leser."
        )
    return ut


# --------------------------------------------------------------------------
# Kommandoer
# --------------------------------------------------------------------------

def skeleton(value, depth: int = 0):
    """Struktur UTEN verdier — bare navn, typer og antall. Trygg å dele."""
    if depth > 5:
        return "..."
    if isinstance(value, dict):
        return {k: skeleton(v, depth + 1) for k, v in list(value.items())[:40]}
    if isinstance(value, list):
        if not value:
            return ["<tom liste>"]
        return [skeleton(value[0], depth + 1), f"... {len(value)} elementer"]
    if isinstance(value, bool):
        return "<bool>"
    if isinstance(value, (int, float)):
        return "<tall>"
    if value is None:
        return "<null>"
    s = str(value)
    if re.fullmatch(r"\d{2}\.\d{2}\.\d{4}([ T]\d{2}:\d{2}(:\d{2})?)?", s) or \
       re.fullmatch(r"\d{4}-\d{2}-\d{2}.*", s):
        return "<dato-lignende tekst>"
    return f"<tekst, {len(s)} tegn>"


def cmd_inspiser(args) -> int:
    doc = load_any(Path(args.fil))
    receipts = find_receipts(doc)
    rapport = {
        "fil": str(args.fil),
        "toppnivaa": type(doc).__name__,
        "toppnokler": sorted(doc.keys())[:40] if isinstance(doc, dict) else None,
        "kvitteringer_funnet": len(receipts),
        "struktur_uten_verdier": skeleton(receipts[0]) if receipts else skeleton(doc),
        "merk": "Denne rapporten inneholder ingen verdier - bare feltnavn, typer og "
                "antall. Den er trygg å dele hvis parseren trenger en oppdatering.",
    }
    if receipts:
        first = receipts[0]
        rapport["gjenkjente_felter"] = {
            "dato": next((k for k in DATE_KEYS if k in first), None),
            "kvitteringsnummer": next((k for k in RECEIPT_ID_KEYS if k in first), None),
            "kjede": next((k for k in CHAIN_KEYS if k in first), None),
            "butikknavn": next((k for k in STORE_KEYS if k in first), None),
            "varelinjer": next((k for k in LINES_KEYS if isinstance(first.get(k), list)), None),
        }
    else:
        rapport["advarsel"] = (
            "Fant ingen kvitteringer. Parseren leter etter objekter med en liste "
            f"under en av {list(LINES_KEYS)}. Del 'struktur_uten_verdier' over — "
            "den inneholder ingen persondata."
        )
    print(json.dumps(rapport, ensure_ascii=False, indent=2))
    return 0 if receipts else 1


def importer_fil(fil: Path) -> dict:
    doc = load_any(fil)
    receipts = find_receipts(doc)
    if not receipts:
        raise TrumfError(
            f"Fant ingen kvitteringer i {fil}.\n"
            "Kjør 'trumf-kvitteringer inspiser <fil>' — den viser strukturen uten "
            "verdier, så den kan deles for å få parseren oppdatert."
        )

    out_dir = receipts_dir()
    out_dir.mkdir(mode=0o700, parents=True, exist_ok=True)

    nye, oppdatert, feilet = [], [], []
    for raw in receipts:
        try:
            norm = normalize_receipt(raw)
        except TrumfError as e:
            feilet.append(str(e))
            continue
        safe = re.sub(r"[^A-Za-z0-9_.-]", "_", norm["kvitteringsnummer"])
        target = out_dir / f"{safe}.json"
        (oppdatert if target.exists() else nye).append(norm["kvitteringsnummer"])
        write_private(target, json.dumps(norm, ensure_ascii=False, indent=2) + "\n")

    alle = les_kvitteringer()
    uten_dato = [k["kvitteringsnummer"] for k in alle if not k.get("dato")]
    resultat = {
        "importert": len(nye) + len(oppdatert),
        "nye": len(nye),
        "oppdatert": len(oppdatert),
        "feilet": len(feilet),
        "mappe": str(out_dir),
    }
    if feilet:
        resultat["feil"] = feilet[:10]
    if uten_dato:
        resultat["advarsel_dato"] = (
            f"{len(uten_dato)} kvitteringer fikk ingen forstått dato. "
            "Se _meta.dato_uforstaatt i filene og legg formatet til i DATE_FORMATS."
        )
    return resultat


def cmd_importer(args) -> int:
    resultat = importer_fil(Path(args.fil))
    print(json.dumps(resultat, ensure_ascii=False, indent=2))
    return 1 if resultat["feilet"] else 0


def les_kvitteringer() -> list[dict]:
    d = receipts_dir()
    if not d.is_dir():
        return []
    ut = []
    for p in sorted(d.glob("*.json")):
        try:
            ut.append(json.loads(p.read_text(encoding="utf-8")))
        except (OSError, json.JSONDecodeError):
            continue
    return ut


def filtrer(kvitteringer, args):
    ut = []
    for k in kvitteringer:
        dato = k.get("dato")
        if args.fra and (dato is None or dato < args.fra):
            continue
        if args.til and (dato is None or dato > args.til):
            continue
        if args.kjede and (k.get("kjede") or "").lower() != args.kjede.lower():
            continue
        ut.append(k)
    return sorted(ut, key=lambda k: (k.get("dato") or "", k["kvitteringsnummer"]),
                  reverse=True)


def cmd_kvitteringer(args) -> int:
    alle = les_kvitteringer()
    if not alle:
        raise TrumfError(
            "Ingen kvitteringer importert ennå.\n"
            "Bestill innsyn på https://www.trumf.no/trumf-profil#/innsyn-og-utlevering "
            "og kjør så:  trumf-kvitteringer importer <fil>"
        )
    valgt = filtrer(alle, args)
    if args.med_varelinjer:
        print(json.dumps(valgt, ensure_ascii=False, indent=2))
    else:
        print(json.dumps([{k: v for k, v in kv.items()
                           if k not in ("varelinjer", "_meta")} for kv in valgt],
                         ensure_ascii=False, indent=2))
    return 0


def cmd_varer(args) -> int:
    alle = les_kvitteringer()
    if not alle:
        raise TrumfError("Ingen kvitteringer importert ennå.")
    agg: dict[str, dict] = {}
    for kv in filtrer(alle, args):
        for linje in kv.get("varelinjer") or []:
            navn = linje.get("varenavn")
            if not navn:
                continue
            key = str(navn).strip().lower()
            rad = agg.setdefault(key, {
                "varenavn": navn, "ean": linje.get("ean"),
                "ganger_kjopt": 0, "sum_antall": 0.0, "sum_belop": 0.0,
            })
            rad["ganger_kjopt"] += 1
            rad["sum_antall"] += linje.get("antall") or 0
            rad["sum_belop"] += linje.get("belop") or 0
            if not rad["ean"] and linje.get("ean"):
                rad["ean"] = linje["ean"]
    rader = sorted(agg.values(), key=lambda r: -r["sum_belop"])
    for r in rader:
        r["sum_antall"] = round(r["sum_antall"], 3)
        r["sum_belop"] = round(r["sum_belop"], 2)
    print(json.dumps(rader[:args.limit] if args.limit else rader,
                     ensure_ascii=False, indent=2))
    return 0


def cmd_status(args) -> int:
    alle = les_kvitteringer()
    datoer = sorted(k["dato"] for k in alle if k.get("dato"))
    bestilling = les_bestilling()
    ut = {
        "kvitteringer": len(alle),
        "tidligste": datoer[0] if datoer else None,
        "seneste": datoer[-1] if datoer else None,
        "uten_dato": sum(1 for k in alle if not k.get("dato")),
        "kjeder": sorted({k["kjede"] for k in alle if k.get("kjede")}),
        "mappe": str(receipts_dir()),
        "sesjon_lagret": Client.session_path().exists(),
        "bestilling_lagt_inn": bestilling.get("bestilt") if bestilling else None,
        "merk": "Denne kommandoen leser bare disk. Bruk 'bestilling' for å "
                "spørre Trumf om dumpen er klar.",
    }
    print(json.dumps(ut, ensure_ascii=False, indent=2))
    return 0


# --------------------------------------------------------------------------
# Hele veien: oppsett -> bestill -> bestilling -> hent
# --------------------------------------------------------------------------

OPPSETT_HJELP = """\
Slik henter du sesjonen (én gang per maskin — den fornyer seg selv etterpå):

  1. Logg inn på https://www.trumf.no i nettleseren, som vanlig, med SMS-koden.
  2. Åpne utviklerverktøyene (F12) -> Nettverk / Network.
  3. Last siden på nytt, høyreklikk en forespørsel til www.trumf.no
     -> Kopier -> Kopier som cURL.
  4. Lim hele kommandoen inn her.

Verktøyet plukker ut informasjonskapslene og kaster resten. Du kan også lime inn
bare Cookie-headeren hvis du heller vil det.

Har du «idsrv» blant kapslene (Applikasjon/Application -> Cookies -> id.trumf.no),
tar sesjonen mye lengre tid å dø. Ta den med hvis du finner den."""


def cmd_oppsett(args) -> int:
    if args.cookie_stdin:
        tekst = sys.stdin.read()
    elif sys.stdin.isatty():
        print(OPPSETT_HJELP, file=sys.stderr)
        print(file=sys.stderr)
        tekst = getpass.getpass("Lim inn (vises ikke), avslutt med Enter: ")
    else:
        raise TrumfError(
            "Uten terminal må sesjonen komme på stdin med --cookie-stdin.\n"
            "Aldri som argument — argumenter havner i ps og skallhistorikk."
        )

    cookies = parse_cookie_input(tekst)
    del tekst
    if not cookies:
        raise TrumfError(
            "Fant ingen informasjonskapsler i det du limte inn.\n" + OPPSETT_HJELP)

    client = Client(verbose=args.verbose)
    client.cookies = cookies
    token = client.ensure_token()          # verifiserer at kapslene faktisk virker
    medlem = client.finn_medlem_id()
    if not medlem:
        raise ShapeChanged(
            "Fikk et token, men fant ikke medlemsnummeret ditt i det.\n"
            f"Ventet «{MEDLEM_CLAIM}». Uten det kan ingen bestilling legges inn."
        )

    sti = client.save_session()
    print(json.dumps({
        "status": "innlogget",
        "medlem_id": maskert(medlem),
        "token_utloper": (datetime.fromtimestamp(token_utloper(token), timezone.utc)
                          .isoformat() if token_utloper(token) else None),
        "informasjonskapsler": sorted(cookies),
        "idsrv_med": "idsrv" in cookies,
        "sesjon": str(sti),
        "data": str(data_dir()),
        "merk": "Passordet ditt har verktøyet aldri sett. Tokenet fornyes "
                "automatisk så lenge kapslene lever; dør de, kjør oppsett igjen. "
                "Én gang per maskin.",
    }, ensure_ascii=False, indent=2))
    return 0


def paalogget_client(args) -> Client:
    client = Client(verbose=getattr(args, "verbose", False))
    client.load_session()
    client.ensure_token()
    return client


def cmd_bestill(args) -> int:
    client = paalogget_client(args)
    lokal = les_bestilling()

    if not args.paa_nytt:
        blokkering = None
        try:
            live = client.hent_bestillingsstatus()
            if live["aktiv"] or live["klar"]:
                blokkering = {
                    "status": "allerede_bestilt",
                    "kilde": "Trumf",
                    "klar": live["klar"],
                    "bestilt": live["bestilt"],
                    "utloper": live["utloper"],
                    "periode": live["periode"],
                }
        except TrumfError as e:
            # Klarer vi ikke spørre Trumf, stoler vi på vår egen notat-lapp
            # heller enn å bestille i blinde.
            client.log(f"statuskallet feilet: {e}")
            if lokal and lokal.get("bestilt"):
                blokkering = {
                    "status": "allerede_bestilt",
                    "kilde": "lokal notat-lapp (statuskallet mot Trumf feilet)",
                    "bestilt": lokal.get("bestilt"),
                    "periode": lokal.get("periode"),
                    "statusfeil": str(e),
                }

        if blokkering:
            blokkering["neste_steg"] = (
                "Er den klar, kjør 'trumf-kvitteringer hent'. Vil du likevel "
                "bestille på nytt, kjør 'trumf-kvitteringer bestill --paa-nytt' — "
                "da erstattes den bestillingen du allerede har."
            )
            blokkering["ventet_dager"] = dager_siden(blokkering.get("bestilt"))
            print(json.dumps(blokkering, ensure_ascii=False, indent=2))
            return 3

    bestilling = client.bestill(
        args.periode,
        per_handel=not args.uten_varelinjer,
        bonus=not args.uten_bonus,
    )
    record = {
        "bestilt": now_iso(),
        "periode": args.periode,
        "format": "JSON",
        "varelinjer": bestilling["onskerSalgshistorikkPerHandel"],
        "bonus": bestilling["onskerSalgshistorikk"],
    }
    sti = skriv_bestilling(record)
    print(json.dumps({
        "status": "bestilt",
        **record,
        "notat": str(sti),
        "merk": "Trumf har inntil 30 dager på seg, men bruker ofte langt mindre. "
                "Verktøyet venter ikke — sjekk med 'trumf-kvitteringer bestilling' "
                "og hent med 'trumf-kvitteringer hent' når den er klar.",
    }, ensure_ascii=False, indent=2))
    return 0


def cmd_bestilling(args) -> int:
    client = paalogget_client(args)
    live = client.hent_bestillingsstatus()
    lokal = les_bestilling() or {}

    ut = {
        "klar": live["klar"],
        "aktiv": live["aktiv"],
        "bestilt": live["bestilt"] or lokal.get("bestilt"),
        "utloper": live["utloper"],
        "periode": live["periode"] or lokal.get("periode"),
        "bestilt_med_dette_verktoyet": lokal.get("bestilt"),
    }
    ut["ventet_dager"] = dager_siden(ut["bestilt"])

    if live["klar"]:
        ut["neste_steg"] = "trumf-kvitteringer hent"
    elif live["aktiv"]:
        ut["neste_steg"] = ("Vent. Trumf har inntil 30 dager på seg. "
                            "Sjekk igjen senere — verktøyet venter ikke for deg.")
    else:
        ut["neste_steg"] = "Ingen aktiv bestilling. Kjør: trumf-kvitteringer bestill"

    print(json.dumps(ut, ensure_ascii=False, indent=2))
    return 0


def cmd_hent(args) -> int:
    client = paalogget_client(args)
    live = client.hent_bestillingsstatus()

    if not live["klar"]:
        print(json.dumps({
            "status": "ikke_klar",
            "aktiv": live["aktiv"],
            "bestilt": live["bestilt"],
            "ventet_dager": dager_siden(live["bestilt"]),
            "neste_steg": ("Vent og prøv igjen." if live["aktiv"]
                           else "Ingen aktiv bestilling. Kjør: trumf-kvitteringer bestill"),
        }, ensure_ascii=False, indent=2))
        return 3

    blob = client.last_ned()
    stempel = (str(live["bestilt"] or now_iso())
               .replace(":", "").replace("-", "").replace(".", ""))
    mal = Path(args.fil) if args.fil else dumps_dir() / f"utlevering-{stempel}.zip"
    write_private_bytes(mal, blob)

    ut = {
        "status": "hentet",
        "fil": str(mal),
        "storrelse_byte": len(blob),
        "bestilt": live["bestilt"],
        "periode": live["periode"],
    }
    if args.ikke_importer:
        ut["merk"] = f"Ikke importert. Kjør: trumf-kvitteringer importer {mal}"
        print(json.dumps(ut, ensure_ascii=False, indent=2))
        return 0

    ut["import"] = importer_fil(mal)
    print(json.dumps(ut, ensure_ascii=False, indent=2))
    return 1 if ut["import"]["feilet"] else 0


def cmd_logout(args) -> int:
    fjernet = []
    filer = [Client.session_path()]
    if args.alt:
        filer.append(bestilling_path())
    for p in filer:
        if p.exists():
            p.unlink()
            fjernet.append(str(p))
    print(json.dumps({
        "status": "utlogget",
        "fjernet": fjernet,
        "merk": "Importerte kvitteringer i " + str(data_dir()) + " er ikke rørt."
                + ("" if args.alt else " Notatet om bestillingen er beholdt; "
                   "bruk --alt for å glemme det også."),
    }, ensure_ascii=False, indent=2))
    return 0


# --------------------------------------------------------------------------

def add_filters(p):
    p.add_argument("--fra", help="Tidligste dato, YYYY-MM-DD")
    p.add_argument("--til", help="Seneste dato, YYYY-MM-DD")
    p.add_argument("--kjede", help="Bare denne kjeden, f.eks. KIWI")


def build_parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(
        prog="trumf-kvitteringer",
        description="Bestill innsynsdumpen fra Trumf, hent den, og les den. "
                    "Har du allerede en dump, kan du importere den uten å logge inn.",
        epilog="Exit: 0 = ok, 1 = delvis, 2 = feil med forklaring, "
               "3 = gjorde ingenting med vilje (allerede bestilt, eller ikke klar).",
    )
    ap.add_argument("--verbose", "-v", action="store_true", help="Logg til stderr")
    sub = ap.add_subparsers(dest="kommando", required=True)

    p = sub.add_parser("oppsett", help="Lim inn sesjonen fra nettleseren, én gang per maskin")
    p.add_argument("--cookie-stdin", action="store_true",
                   help="Les informasjonskapslene fra stdin i stedet for å spørre")
    p.set_defaults(func=cmd_oppsett)

    p = sub.add_parser("bestill", help="Legg inn innsynsbestillingen hos Trumf")
    p.add_argument("--periode", choices=PERIODER, default="SISTE_3_AR")
    p.add_argument("--paa-nytt", action="store_true",
                   help="Bestill selv om det allerede finnes en bestilling")
    p.add_argument("--uten-varelinjer", action="store_true",
                   help="Dropp kjøpstransaksjoner per handel per vare (da får du "
                        "ingen varelinjer å parse)")
    p.add_argument("--uten-bonus", action="store_true",
                   help="Dropp bonustransaksjoner")
    p.set_defaults(func=cmd_bestill)

    p = sub.add_parser("bestilling", help="Er dumpen klar? Spør Trumf")
    p.set_defaults(func=cmd_bestilling)

    p = sub.add_parser("hent", help="Last ned dumpen når den er klar, og importer den")
    p.add_argument("--fil", help="Lagre zip-en her i stedet for datamappen")
    p.add_argument("--ikke-importer", action="store_true",
                   help="Bare last ned, ikke parse")
    p.set_defaults(func=cmd_hent)

    p = sub.add_parser("logout", help="Glem sesjonen")
    p.add_argument("--alt", action="store_true",
                   help="Glem også notatet om at du har bestilt")
    p.set_defaults(func=cmd_logout)

    p = sub.add_parser("inspiser", help="Vis strukturen i en dump uten å vise verdier")
    p.add_argument("fil")
    p.set_defaults(func=cmd_inspiser)

    p = sub.add_parser("importer", help="Parse en dump og lagre normaliserte kvitteringer")
    p.add_argument("fil")
    p.set_defaults(func=cmd_importer)

    p = sub.add_parser("kvitteringer", help="List importerte kvitteringer")
    add_filters(p)
    p.add_argument("--med-varelinjer", action="store_true")
    p.set_defaults(func=cmd_kvitteringer)

    p = sub.add_parser("varer", help="Summer per vare, dyreste først")
    add_filters(p)
    p.add_argument("--limit", type=int)
    p.set_defaults(func=cmd_varer)

    p = sub.add_parser("status", help="Hva ligger på disk")
    p.set_defaults(func=cmd_status)

    return ap


def main(argv=None) -> int:
    args = build_parser().parse_args(argv)
    try:
        return args.func(args)
    except TrumfError as e:
        print(f"trumf-kvitteringer: {e}", file=sys.stderr)
        return 2
    except KeyboardInterrupt:
        print("avbrutt", file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main())
