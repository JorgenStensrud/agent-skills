#!/usr/bin/env python3
"""scan-secrets — block credentials and personal data from entering the repo.

Why this exists
---------------
This repo is private today but should be publishable later. Making a repo
public exposes the *entire git history*, not just the current tree, so a
secret committed while private is still readable the day it goes public.
Deleting the file later does not help: the content stays reachable from the
earlier commit. Only a history rewrite removes it, and that breaks every
clone and still requires rotating the secret.

The primary defence is therefore that credentials live outside the repo
(`~/.config/<skill>/`, mode 0600 — see AUTH.md). This scanner is the second
line: it catches the accident where a real response, token, or export gets
pasted into a file and staged.

Deliberately narrow
-------------------
A noisy guard gets bypassed with `--no-verify`, and a bypassed guard is
worth nothing. So this only matches things that are unambiguous:

  * vendor-prefixed tokens with enough length to not be a placeholder
  * private-key armour
  * filenames that should never be committed at all

It does NOT try to match generic `password = ...` assignments — real docs
are full of those, and every false positive trains you to skip the hook.

Escape hatch: put `scan-secrets: ignore` on the same line for a deliberate
example that trips a pattern.

Run:
  scripts/scan-secrets              # staged content (what pre-commit uses)
  scripts/scan-secrets --all        # every tracked file
  scripts/scan-secrets FILE...      # specific files

Exit code: 0 = clean, 1 = findings.
"""
from __future__ import annotations

import argparse
import re
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
SELF = Path(__file__).resolve()

# Skip anything larger than this; secrets are small, and huge files are
# usually vendored assets that would only slow the hook down.
MAX_BYTES = 2_000_000

ALLOW_MARKER = "scan-secrets: ignore"

# Patterns are split with character classes so this file does not match
# itself when scanned as part of the tree.
CONTENT_RULES: list[tuple[str, re.Pattern[str]]] = [
    ("Resend API key",
     re.compile(r"\bre" + r"_[A-Za-z0-9]{16,}")),
    ("GitHub token",
     re.compile(r"\bgh[pousr]" + r"_[A-Za-z0-9]{20,}")),
    ("GitHub fine-grained PAT",
     re.compile(r"\bgithub_pat" + r"_[A-Za-z0-9_]{30,}")),
    ("OpenAI/Anthropic-style API key",
     re.compile(r"\bsk-(?:ant-)?[A-Za-z0-9_-]{24,}")),
    ("Slack token",
     re.compile(r"\bxox[abprs]" + r"-[A-Za-z0-9-]{10,}")),
    ("AWS access key id",
     re.compile(r"\bAKIA[0-9A-Z]{16}\b")),
    ("Google API key",
     re.compile(r"\bAIza[0-9A-Za-z_-]{35}\b")),
    ("private key block",
     re.compile(r"-----BEGIN (?:[A-Z ]+ )?PRIVATE KEY-----")),
    ("Django session cookie value",
     re.compile(r"\bsessionid=[A-Za-z0-9]{20,}")),
    ("csrf token value",
     re.compile(r"\bcsrftoken=[A-Za-z0-9]{20,}")),
    ("Oda client token header with a value",
     re.compile(r"X-Client-Token\s*:\s*[A-Za-z0-9]{12,}", re.I)),
    ("bearer token",
     re.compile(r"\bBearer\s+[A-Za-z0-9._-]{30,}")),
]

# Files that must never be committed, matched on path. Unlike the content
# rules these need no heuristics: the name alone is the finding.
PATH_RULES: list[tuple[str, re.Pattern[str]]] = [
    ("environment file with real values",
     re.compile(r"(^|/)\.env(\.|$)(?!example|sample|template)")),
    ("credential file",
     re.compile(r"(^|/)credentials(\.|$)")),
    ("secrets file",
     re.compile(r"(^|/)secrets\.")),
    ("saved session",
     re.compile(r"(^|/)[^/]*session[^/]*\.json$")),
    ("saved cookies",
     re.compile(r"(^|/)[^/]*cookies[^/]*\.json$")),
    ("saved token",
     re.compile(r"(^|/)[^/]*token[^/]*\.json$")),
    ("private key file",
     re.compile(r"\.(pem|key|p12|pfx)$")),
    ("fetched receipt/order data",
     re.compile(r"\.(receipts|kvitteringer|orders|ordrer)\.json$")),
]


def staged_files() -> list[str]:
    out = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z"],
        cwd=REPO_ROOT, capture_output=True, text=True, check=True,
    ).stdout
    return [p for p in out.split("\0") if p]


def tracked_files() -> list[str]:
    out = subprocess.run(
        ["git", "ls-files", "-z"],
        cwd=REPO_ROOT, capture_output=True, text=True, check=True,
    ).stdout
    return [p for p in out.split("\0") if p]


def staged_blob(path: str) -> str | None:
    """Read the staged content, which is what actually gets committed —
    reading the worktree file would miss a `git add -p` that staged a secret
    and then edited it away."""
    r = subprocess.run(["git", "show", f":{path}"],
                       cwd=REPO_ROOT, capture_output=True)
    if r.returncode != 0:
        return None
    if len(r.stdout) > MAX_BYTES or b"\0" in r.stdout[:8192]:
        return None
    return r.stdout.decode("utf-8", errors="replace")


def worktree_blob(path: str) -> str | None:
    p = REPO_ROOT / path
    try:
        if p.stat().st_size > MAX_BYTES:
            return None
        raw = p.read_bytes()
    except OSError:
        return None
    if b"\0" in raw[:8192]:
        return None
    return raw.decode("utf-8", errors="replace")


def scan(paths: list[str], read) -> list[str]:
    findings: list[str] = []

    for path in paths:
        if (REPO_ROOT / path).resolve() == SELF:
            continue

        for label, rx in PATH_RULES:
            if rx.search(path):
                findings.append(f"{path}: {label} — this must not be committed")
                break

        text = read(path)
        if text is None:
            continue
        for lineno, line in enumerate(text.splitlines(), 1):
            if ALLOW_MARKER in line:
                continue
            for label, rx in CONTENT_RULES:
                m = rx.search(line)
                if m:
                    hit = m.group(0)
                    shown = hit[:12] + "…" if len(hit) > 12 else hit
                    findings.append(f"{path}:{lineno}: {label} — matched `{shown}`")
                    break

    return findings


def main() -> int:
    ap = argparse.ArgumentParser(prog="scan-secrets")
    ap.add_argument("--all", action="store_true",
                    help="Scan every tracked file instead of staged content")
    ap.add_argument("paths", nargs="*", help="Specific files to scan")
    args = ap.parse_args()

    if args.paths:
        findings = scan(args.paths, worktree_blob)
        scanned = len(args.paths)
    elif args.all:
        files = tracked_files()
        findings = scan(files, worktree_blob)
        scanned = len(files)
    else:
        files = staged_files()
        findings = scan(files, staged_blob)
        scanned = len(files)

    if findings:
        for f in findings:
            print(f"SECRET:  {f}", file=sys.stderr)
        print(
            f"\nFAILED: {len(findings)} finding(s) in {scanned} file(s).\n"
            "\n"
            "Credentials and fetched personal data belong outside the repo —\n"
            "~/.config/<skill>/ with mode 0600. See AUTH.md.\n"
            "\n"
            "If this is a deliberate example, add `scan-secrets: ignore` to\n"
            "that line. If a real secret was already committed earlier, the\n"
            "history still holds it: rotate the secret first, then decide\n"
            "whether a rewrite is worth it.",
            file=sys.stderr,
        )
        return 1

    print(f"OK: no secrets found in {scanned} file(s)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
