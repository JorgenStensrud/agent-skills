#!/usr/bin/env python3
"""validate-skills — sanity-check every skill under skills/ before commit.

Checks (fails on any):
  1. skills/<name>/SKILL.md exists and is readable
  2. YAML frontmatter starts on line 1, closes with `---`
  3. Frontmatter has `name:` and `description:` (non-empty strings)
  4. `description:` <= 500 chars
  5. `name:` unique across all skills
  6. `name:` matches folder name (unless folder name is prefixed differently
     on purpose — we log a warning, not a hard fail)
  7. Symlinked skills resolve (target exists)
  8. No stray `__pycache__/` inside any skill folder

Warnings only (do not fail):
  - description not quoted / not a block scalar (harder for YAML tools)
  - description looks long-form / doc-like rather than a trigger phrase

Exit code: 0 = clean, 1 = errors, 2 = warnings only (still allowed to commit).
Run:  scripts/validate-skills [--strict]
      --strict promotes warnings to errors.
"""
from __future__ import annotations

import argparse
import os
import re
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
SKILLS_DIR = REPO_ROOT / "skills"
MAX_DESC_LEN = 500

FM_RE = re.compile(r"\A---\r?\n(.*?)\r?\n---\s*\r?\n", re.DOTALL)


def parse_frontmatter(text: str) -> tuple[dict | None, str | None]:
    """Minimal YAML frontmatter parser (stdlib only). Handles the subset we
    actually use: `key: value` scalar lines, `key: "value"`, and `key: >-`
    folded blocks. Anything else is passed through as a raw string; a real
    YAML parser is not stdlib in Python, but the checks below don't need one.
    """
    m = FM_RE.match(text)
    if not m:
        return None, "frontmatter must start on line 1 and close with `---`"
    body = m.group(1)
    data: dict[str, str] = {}
    key = None
    buf: list[str] = []
    folded = False

    def flush():
        nonlocal buf, folded
        if key is None:
            return
        if folded:
            data[key] = " ".join(s.strip() for s in buf if s.strip())
        else:
            data[key] = "\n".join(buf).strip()
        buf = []

    for line in body.splitlines():
        if re.match(r"^[A-Za-z_][A-Za-z0-9_-]*:", line):
            flush()
            k, _, v = line.partition(":")
            key = k.strip()
            v = v.strip()
            if v in (">-", ">", "|-", "|"):
                folded = v.startswith(">")
                buf = []
            else:
                # unquote if wrapped
                v = re.sub(r'^"(.*)"$', r"\1", v)
                v = re.sub(r"^'(.*)'$", r"\1", v)
                data[key] = v
                key = None
                folded = False
        elif key is not None:
            buf.append(line)
    flush()
    return data, None


def looks_quoted(raw_line: str) -> bool:
    v = raw_line.split(":", 1)[1].strip()
    return v.startswith(('"', "'", ">", "|"))


def check_skill(skill_dir: Path) -> tuple[list[str], list[str]]:
    """Return (errors, warnings) for one skill directory."""
    errs: list[str] = []
    warns: list[str] = []
    prefix = f"skills/{skill_dir.name}/"

    skill_md = skill_dir / "SKILL.md"
    if not skill_md.exists():
        errs.append(f"{prefix}SKILL.md missing")
        return errs, warns

    # Symlink resolution: if the skill dir (or SKILL.md) is a broken symlink
    if skill_dir.is_symlink():
        target = os.readlink(skill_dir)
        resolved = (skill_dir.parent / target).resolve()
        if not resolved.exists():
            errs.append(f"{prefix} symlink target does not exist: {target}")
            return errs, warns

    try:
        text = skill_md.read_text(encoding="utf-8")
    except OSError as e:
        errs.append(f"{prefix}SKILL.md unreadable: {e}")
        return errs, warns

    data, err = parse_frontmatter(text)
    if err:
        errs.append(f"{prefix}SKILL.md: {err}")
        return errs, warns
    if not isinstance(data, dict):
        errs.append(f"{prefix}SKILL.md: frontmatter not a mapping")
        return errs, warns

    for field in ("name", "description"):
        v = data.get(field)
        if not (isinstance(v, str) and v.strip()):
            errs.append(f"{prefix}SKILL.md: missing/empty `{field}`")

    name = data.get("name", "").strip()
    desc = data.get("description", "").strip()

    if name and name != skill_dir.name:
        warns.append(
            f"{prefix}SKILL.md: name=`{name}` does not match folder=`{skill_dir.name}` "
            f"(fine if the rename is intentional — e.g. renamed to avoid collision)"
        )

    if desc and len(desc) > MAX_DESC_LEN:
        errs.append(
            f"{prefix}SKILL.md: description is {len(desc)} chars (>{MAX_DESC_LEN}); "
            f"trim to a trigger phrase, not a doc"
        )

    # Description-quoting hint: scan the raw frontmatter for the description line.
    fm = FM_RE.match(text).group(1)  # type: ignore[union-attr]
    for raw in fm.splitlines():
        if raw.lstrip().startswith("description:"):
            if not looks_quoted(raw):
                warns.append(
                    f"{prefix}SKILL.md: `description:` value should be quoted or a "
                    f"`>-` folded block for YAML-tool safety"
                )
            break

    # __pycache__ hygiene
    pycache = list(skill_dir.rglob("__pycache__"))
    if pycache:
        warns.append(
            f"{prefix}: {len(pycache)} `__pycache__/` dir(s) present — should be "
            f"gitignored / removed before commit"
        )

    return errs, warns


def main() -> int:
    ap = argparse.ArgumentParser(prog="validate-skills")
    ap.add_argument("--strict", action="store_true",
                    help="Promote warnings to errors")
    args = ap.parse_args()

    if not SKILLS_DIR.is_dir():
        print(f"error: {SKILLS_DIR} not found", file=sys.stderr)
        return 1

    all_errs: list[str] = []
    all_warns: list[str] = []
    names: dict[str, str] = {}

    skill_dirs = sorted(p for p in SKILLS_DIR.iterdir() if p.is_dir() or p.is_symlink())
    for skill in skill_dirs:
        if skill.name.startswith("."):
            continue
        errs, warns = check_skill(skill)
        all_errs.extend(errs)
        all_warns.extend(warns)
        # Uniqueness check
        skill_md = skill / "SKILL.md"
        if skill_md.exists():
            data, _ = parse_frontmatter(skill_md.read_text(encoding="utf-8", errors="ignore"))
            if isinstance(data, dict):
                nm = str(data.get("name", "")).strip()
                if nm:
                    if nm in names:
                        all_errs.append(
                            f"duplicate skill name `{nm}` in both "
                            f"skills/{names[nm]}/ and skills/{skill.name}/"
                        )
                    else:
                        names[nm] = skill.name

    for e in all_errs:
        print(f"ERROR:   {e}", file=sys.stderr)
    for w in all_warns:
        print(f"WARN:    {w}", file=sys.stderr)

    if not all_errs and not all_warns:
        print(f"OK: {len(skill_dirs)} skills validated")
        return 0
    if all_errs:
        print(f"\nFAILED: {len(all_errs)} error(s), {len(all_warns)} warning(s)",
              file=sys.stderr)
        return 1
    print(f"\nPASSED with {len(all_warns)} warning(s)", file=sys.stderr)
    return 1 if args.strict else 0


if __name__ == "__main__":
    sys.exit(main())
